        RGDS.version_badge(), 
            RGDS.draw_background(G.SPLASH_BACK)
            RGDS.route(v)
            RGDS.route(v)
        RGDS.route(G.SPLASH_LOGO)
    RGDS.draw_upper_overlay()
                RGDS.route(v)
                RGDS.route(v)
                RGDS.route(v)
                RGDS.route(v)
                RGDS.route(v)
            RGDS.draw_flash(G.SPLASH_FRONT)
            RGDS.route(self.OVERLAY_TUTORIAL)
                for k, v in ipairs(RGDS.live_tutorial_highlights(self.OVERLAY_TUTORIAL)) do
                    RGDS.route(v)
            RGDS.route(self.OVERLAY_MENU)
            RGDS.route(self.debug_tools)
        RGDS.route(v)
            RGDS.route(G.CONTROLLER.dragging.target)
            RGDS.route(G.CONTROLLER.focused.target)
        RGDS.route(v)
            RGDS.route(self.achievement_notification)
            RGDS.route(self.screenwipe)
        RGDS.route(self.CURSOR)
    love.graphics.setScissor()
        if G.SETTINGS.GRAPHICS.crt > 0 then love.graphics.setShader( G.SHADERS['CRT']) else love.graphics.setShader() end
